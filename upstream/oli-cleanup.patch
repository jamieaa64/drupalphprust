+
+## Project deletion cleanup
+
+After deletion confirmation, `delete_project` runs an optional
+`.drupalaibp/before-delete.sh` with Bash in the selected project directory.
+Cleanup failure or DDEV deletion failure preserves the directory and aborts.
+This is deliberately strict, unlike best-effort installation events.
diff --git a/README.md b/README.md
index 8a9e8f3..606832a 100644
--- a/README.md
+++ b/README.md
@@ -114,3 +114,13 @@ and `AGENTS.md` for the full picture.
 ## Limitations
 
 - Windows is not supported (WSL2 with a supported Linux distribution works).
+
+### Project-owned cleanup on deletion
+
+A project may provide `.drupalaibp/before-delete.sh`. After the user confirms
+project deletion, the installer runs this script with Bash in that project's
+root, before `ddev delete`. Use it to release resources the project itself
+created, preserving shared resources and other projects. Any authentication is
+handled directly in the user's terminal. A nonzero cleanup exit aborts deletion
+and preserves the directory for retry. DDEV failure also preserves the directory.
+This applies both when deleting the current project and selecting a child project.
diff --git a/drupalaibp b/drupalaibp
index ad3ce14..34ca22d 100755
--- a/drupalaibp
+++ b/drupalaibp
@@ -2494,6 +2494,16 @@ _selenium_headed_rewrite() {
 }
 
 # src/lib/delete/delete_project.sh
+# Optional project cleanup runs only after delete confirmation, in the selected
+# project directory. Unlike best-effort install hooks, failure must stop deletion
+# so credentials can be supplied and cleanup retried without losing its receipt.
+_delete_project_cleanup() {
+  if [[ -e .drupalaibp/before-delete.sh ]]; then
+    step "Cleaning up project-owned resources..."
+    bash .drupalaibp/before-delete.sh || return 1
+  fi
+}
+
 # Delete a DDEV project. If the current directory is itself a DDEV project, offer
 # to delete this one (confirm, `ddev delete -Oy`, then `cd ..` and remove the
 # directory). Otherwise fall back to listing DDEV projects running in immediate
@@ -2515,7 +2525,8 @@ delete_project() {
     [[ $MENU_INDEX -eq 0 ]] || die "Aborted. Nothing was deleted."
 
     step "Deleting DDEV project '${name}'..."
-    ddev delete -Oy
+    _delete_project_cleanup || die "Project cleanup failed; deletion stopped."
+    ddev delete -Oy || die "DDEV deletion failed; directory preserved."
 
     step "Removing directory '${cur}'..."
     cd .. || die "Could not leave the project directory; nothing was removed."
@@ -2551,7 +2562,8 @@ delete_project() {
   [[ $MENU_INDEX -eq 0 ]] || die "Aborted. Nothing was deleted."
 
   step "Deleting DDEV project in '${target}'..."
-  ( cd "$target" && ddev delete -Oy )
+  ( cd "$target" && _delete_project_cleanup && ddev delete -Oy ) \
+    || die "Project cleanup or DDEV deletion failed; directory preserved."
 
   step "Removing directory '${target}'..."
   rm -rf "$target"
