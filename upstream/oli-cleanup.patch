diff --git a/tests/bats/lib/delete/delete_project.bats b/tests/bats/lib/delete/delete_project.bats
index 0169aee..6f5e8df 100644
--- a/tests/bats/lib/delete/delete_project.bats
+++ b/tests/bats/lib/delete/delete_project.bats
@@ -124,3 +124,56 @@ make_ddev_project() {  # <dir> <name>
   refute_called "ddev delete"
   refute_called "rm -rf"
 }
+
+@test "cleanup runs in selected project before DDEV deletion" {
+  make_ddev_project proj-a site-a
+  mkdir -p proj-a/.drupalaibp
+  printf 'echo "cleanup:$PWD" >> "$OLI_CALLS"\n' > proj-a/.drupalaibp/before-delete.sh
+  docker() { printf 'ddev-site-a-web\n'; }
+  MENU_ANSWERS=(0 0)
+  run delete_project
+  [ "$status" -eq 0 ]
+  assert_called "cleanup:${OLI_WORK}/proj-a"
+  assert_called "ddev delete -Oy"
+  assert_called "rm -rf proj-a"
+}
+
+@test "failed cleanup preserves project and skips DDEV deletion" {
+  make_ddev_project . site-a
+  mkdir -p .drupalaibp
+  echo 'exit 9' > .drupalaibp/before-delete.sh
+  run delete_project
+  [ "$status" -ne 0 ]
+  refute_called "ddev delete"
+  refute_called "rm -rf"
+}
+
+@test "declined delete does not run cleanup" {
+  make_ddev_project . site-a
+  mkdir -p .drupalaibp
+  echo 'echo cleanup >> "$OLI_CALLS"' > .drupalaibp/before-delete.sh
+  MENU_ANSWERS=(1)
+  run delete_project
+  [ "$status" -ne 0 ]
+  refute_called "cleanup"
+}
+
+@test "DDEV failure preserves directory after successful cleanup" {
+  make_ddev_project . site-a
+  ddev() { return 1; }
+  run delete_project
+  [ "$status" -ne 0 ]
+  refute_called "rm -rf"
+}
+
+@test "failed subdirectory cleanup preserves the selected project" {
+  make_ddev_project proj-a site-a
+  mkdir -p proj-a/.drupalaibp
+  echo 'exit 9' > proj-a/.drupalaibp/before-delete.sh
+  docker() { printf 'ddev-site-a-web\n'; }
+  MENU_ANSWERS=(0 0)
+  run delete_project
+  [ "$status" -ne 0 ]
+  refute_called "ddev delete"
+  refute_called "rm -rf"
+}
