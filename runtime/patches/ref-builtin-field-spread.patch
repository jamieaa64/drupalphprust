+    fn emit_ref_builtin_rest(&mut self, name: &[u8], slot: crate::hir::Slot, rest: &[Expr]) -> R<()> {
+        if rest.iter().any(|a| matches!(a.kind, ExprKind::Spread(_))) {
+            let mut spreads = Vec::with_capacity(rest.len());
+            for a in rest {
+                if let ExprKind::Spread(src) = &a.kind {
+                    self.expr(src)?;
+                    spreads.push(true);
+                } else {
+                    self.expr(a)?;
+                    spreads.push(false);
+                }
+            }
+            self.emit(Op::CallBuiltinRefSpread { name: name.into(), slot, spreads: spreads.into() });
+        } else {
+            self.push_value_args(rest)?;
+            self.emit(Op::CallBuiltinRef { name: name.into(), slot, argc: rest.len() as u32 });
+        }
+        Ok(())
+    }
+
+    /// Bind the already evaluated field cell to a fresh temporary for spread calls.
+    fn emit_ref_cell_rest(&mut self, name: &[u8], rest: &[Expr]) -> R<()> {
+        if rest.iter().any(|a| matches!(a.kind, ExprKind::Spread(_))) {
+            let slot = self.alloc_temp();
+            self.emit(Op::BindRefTo { base: FieldBase::Local(slot), steps: [].into() });
+            self.emit(Op::Pop);
+            self.emit_ref_builtin_rest(name, slot, rest)?;
+            self.clear_temp_binding(slot);
+            self.free_temp();
+        } else {
+            self.push_value_args(rest)?;
+            self.emit(Op::CallBuiltinRefCell { name: name.into(), argc: rest.len() as u32 });
+        }
+        Ok(())
     }
 
