+/// SPL performs stat without emitting a warning or invoking user error handlers.
+/// The prelude turns a failure into its method-specific RuntimeException.
+pub fn spl_filectime(argv: &[Zval], ctx: &mut Ctx) -> Result<Zval, PhpError> {
+    let path = arg_os_path(argv, ctx);
+    Ok(match std::fs::metadata(path) {
+        Ok(metadata) => Zval::Long(stat_vals(&metadata)[10]),
+        Err(_) => Zval::Bool(false),
+    })
+}
+
 pub fn filectime(argv: &[Zval], ctx: &mut Ctx) -> Result<Zval, PhpError> {
