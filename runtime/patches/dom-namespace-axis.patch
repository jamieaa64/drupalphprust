+// XPath namespace nodes have their own PHP type, not DOMNode inheritance.
+class DOMNameSpaceNode {
+    private $__doc;
+    private $__owner;
+    private $__prefix;
+    private $__uri;
+    public static function __make($doc, $owner, $prefix, $uri) {
+        $n = new DOMNameSpaceNode();
+        $n->__doc = $doc; $n->__owner = $owner;
+        $n->__prefix = $prefix; $n->__uri = $uri;
+        return $n;
+    }
+    public function __get($name) {
+        switch ($name) {
+            case 'nodeName': return $this->__prefix === '' ? 'xmlns' : 'xmlns:' . $this->__prefix;
+            case 'nodeValue': return $this->__uri === '' ? null : $this->__uri;
+            case 'nodeType': return 18;
+            case 'prefix': return $this->__prefix;
+            case 'localName': return $this->__prefix === '' ? 'xmlns' : $this->__prefix;
+            case 'namespaceURI': return $this->__uri;
+            case 'ownerDocument': return DOMNode::__wrap($this->__doc, 0);
+            case 'parentNode': return DOMNode::__wrap($this->__doc, $this->__owner);
+        }
+        trigger_error('Undefined property: DOMNameSpaceNode::$' . $name, E_USER_WARNING);
+        return null;
+    }
+    public function __isset($name) {
+        if (!in_array($name, ['nodeName', 'nodeValue', 'nodeType', 'prefix', 'localName', 'namespaceURI', 'ownerDocument', 'parentNode'], true)) { return false; }
+        return $this->__get($name) !== null;
+    }
+    public function __set($name, $value) {
+        throw new Error('Cannot modify readonly property DOMNameSpaceNode::$' . $name);
+    }
+}
