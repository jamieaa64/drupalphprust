+// In-memory ext/xmlwriter. Native libxml state is request-local, never a PHP property.
+class XMLWriter {
+    public function openMemory() { return __xmlwriter($this, "openMemory"); }
+    public function setIndent(bool $enable) { return __xmlwriter($this, "setIndent", $enable); }
+    public function setIndentString(string $indentation) { return __xmlwriter($this, "setIndentString", $indentation); }
+    public function startDocument(?string $version = '1.0', ?string $encoding = null, ?string $standalone = null) { return __xmlwriter($this, "startDocument", $version, $encoding, $standalone); }
+    public function endDocument() { return __xmlwriter($this, "endDocument"); }
+    public function startElement(string $name) { return __xmlwriter($this, "startElement", $name); }
+    public function endElement() { return __xmlwriter($this, "endElement"); }
+    public function fullEndElement() { return __xmlwriter($this, "fullEndElement"); }
+    public function writeElement(string $name, ?string $content = null) { return __xmlwriter($this, "writeElement", $name, $content); }
+    public function startElementNs(?string $prefix, string $name, ?string $namespace) { return __xmlwriter($this, "startElementNs", $prefix, $name, $namespace); }
+    public function writeElementNs(?string $prefix, string $name, ?string $namespace, ?string $content = null) { return __xmlwriter($this, "writeElementNs", $prefix, $name, $namespace, $content); }
+    public function startAttribute(string $name) { return __xmlwriter($this, "startAttribute", $name); }
+    public function endAttribute() { return __xmlwriter($this, "endAttribute"); }
+    public function writeAttribute(string $name, string $value) { return __xmlwriter($this, "writeAttribute", $name, $value); }
+    public function startAttributeNs(?string $prefix, string $name, ?string $namespace) { return __xmlwriter($this, "startAttributeNs", $prefix, $name, $namespace); }
+    public function writeAttributeNs(?string $prefix, string $name, ?string $namespace, string $value) { return __xmlwriter($this, "writeAttributeNs", $prefix, $name, $namespace, $value); }
+    public function text(string $content) { return __xmlwriter($this, "text", $content); }
+    public function writeRaw(string $content) { return __xmlwriter($this, "writeRaw", $content); }
+    public function writeComment(string $content) { return __xmlwriter($this, "writeComment", $content); }
+    public function startComment() { return __xmlwriter($this, "startComment"); }
+    public function endComment() { return __xmlwriter($this, "endComment"); }
+    public function writeCdata(string $content) { return __xmlwriter($this, "writeCdata", $content); }
+    public function startCdata() { return __xmlwriter($this, "startCdata"); }
+    public function endCdata() { return __xmlwriter($this, "endCdata"); }
+    public function writePi(string $target, string $content) { return __xmlwriter($this, "writePi", $target, $content); }
+    public function startPi(string $target) { return __xmlwriter($this, "startPi", $target); }
+    public function endPi() { return __xmlwriter($this, "endPi"); }
+    public function outputMemory(bool $flush = true) { return __xmlwriter($this, "outputMemory", $flush); }
+    public function flush(bool $empty = true) { return __xmlwriter($this, "flush", $empty); }
+}
