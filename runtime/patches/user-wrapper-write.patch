+        // or stream_write throws. Ordinary failures still flush/close.
+        if result.is_err() { self.gc_note(&obj); return result; }
+        let flushed = if dirty && has(self, b"stream_flush") {
+            self.call_method_sync(obj.clone(), b"stream_flush", Vec::new())
+        } else { Ok(Zval::Bool(true)) };
+        if let Err(error) = flushed { self.gc_note(&obj); return Err(error); }
+        let closed = if has(self, b"stream_close") {
+            self.call_method_sync(obj.clone(), b"stream_close", Vec::new())
+        } else { Ok(Zval::Null) };
+        self.gc_note(&obj);
+        result.and_then(|value| { closed?; Ok(value) })
+    }
