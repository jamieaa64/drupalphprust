 //! VM coroutines logic, extracted from vm/mod.rs (no semantic change).
 use super::*;
 
+pub(super) enum NativeFiberCall {
+    Unhandled,
+    Complete,
+    Suspended(Zval),
+}
+
 impl<'m> Vm<'m> {
+    /// Native Fiber statics must work for both linked and dynamic class calls.
+    pub(super) fn native_fiber_static(
+        &mut self, top: usize, class: ClassId, method: &[u8],
+        args: &mut Vec<Zval>, named: &[(Box<[u8]>, Zval)],
+    ) -> Result<NativeFiberCall, PhpError> {
+        if self.fiber_class_id != Some(class) {
+            return Ok(NativeFiberCall::Unhandled);
+        }
+        if method.eq_ignore_ascii_case(b"getcurrent") {
+            if let Some((name, _)) = named.first() {
+                return Err(PhpError::Error(format!("Unknown named parameter ${}", String::from_utf8_lossy(name))));
+            }
+            if !args.is_empty() {
+                return Err(PhpError::ArgumentCountError(format!("Fiber::getCurrent() expects exactly 0 arguments, {} given", args.len())));
+            }
+            let cur = self.fiber_stack.last().map(|c| c.obj.clone()).unwrap_or(Zval::Null);
+            self.frames[top].stack.push(cur);
+            return Ok(NativeFiberCall::Complete);
+        }
+        if !method.eq_ignore_ascii_case(b"suspend") {
+            return Ok(NativeFiberCall::Unhandled);
+        }
+        if args.len() > 1 {
+            return Err(PhpError::ArgumentCountError(format!("Fiber::suspend() expects at most 1 argument, {} given", args.len())));
+        }
+        let (id, baseline) = match self.fiber_stack.last() {
+            Some(c) => (c.id, c.baseline),
+            None => return Err(PhpError::Error("Cannot suspend outside of a fiber".to_string())),
+        };
+        if args.iter().any(|a| matches!(a, Zval::ArgPlace(_))) {
+            self.materialize_arg_places(top, args, None)?;
+        }
+        let mut value = args.first().map(|v| v.deref_clone()).unwrap_or(Zval::Null);
+        for (name, v) in named {
+            if &name[..] != b"value" {
+                return Err(PhpError::Error(format!("Unknown named parameter ${}", String::from_utf8_lossy(name))));
+            }
+            if !args.is_empty() {
+                return Err(PhpError::Error("Named parameter $value overwrites previous argument".to_string()));
+            }
+            value = v.deref_clone();
+        }
+        let parked = self.frames.split_off(baseline);
+        self.fibers.get_mut(&id).expect("running fiber state").parked = parked;
+        Ok(NativeFiberCall::Suspended(value))
+    }
