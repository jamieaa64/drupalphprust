@@ -0,0 +1,156 @@
+//! Generator operations that survive a Fiber suspension. No PHP operation is replayed.
+use super::*;
+
+pub(super) enum GeneratorAfter {
+    Foreach { value: u32, key: Option<u32>, end: u32 },
+    YieldFrom,
+    Method { method: Vec<u8>, next: Option<Zval> },
+}
+
+pub(super) struct GeneratorDrive {
+    pub(super) baseline: usize,
+    pub(super) consumer: usize,
+    pub(super) generator: Rc<RefCell<GenState>>,
+    pub(super) after: GeneratorAfter,
+}
+
+impl<'m> Vm<'m> {
+    fn accept_generator_exit(&mut self, rc: &Rc<RefCell<GenState>>, exit: RunExit) {
+        let mut gs = rc.borrow_mut();
+        match exit {
+            RunExit::Yielded { key, value } => {
+                let key = match key {
+                    GenKey::Auto => { let k = gs.auto_key; gs.auto_key += 1; Zval::Long(k) }
+                    GenKey::Keyed(Zval::Long(n)) => { if n >= gs.auto_key { gs.auto_key = n.wrapping_add(1); } Zval::Long(n) }
+                    GenKey::Keyed(k) | GenKey::Verbatim(k) => k,
+                };
+                gs.cur_key = key;
+                gs.cur_val = value;
+                gs.status = GenStatus::Suspended;
+            }
+            RunExit::Returned(value) => {
+                gs.ret = value;
+                gs.cur_key = Zval::Null;
+                gs.cur_val = Zval::Null;
+                gs.status = GenStatus::Done;
+            }
+            RunExit::Suspended { .. } => unreachable!("handled by the Fiber driver"),
+        }
+    }
+
+    pub(super) fn generator_result(&mut self, rc: &Rc<RefCell<GenState>>, method: &[u8]) -> Result<Zval, PhpError> {
+        let gs = rc.borrow();
+        match method {
+            b"current" | b"send" => Ok(gs.cur_val.clone()),
+            b"key" => Ok(gs.cur_key.clone()),
+            b"valid" => Ok(Zval::Bool(!matches!(gs.status, GenStatus::Done))),
+            b"next" => Ok(Zval::Null),
+            b"rewind" if !gs.advanced => Ok(Zval::Null),
+            b"rewind" => { drop(gs); Err(self.gen_exception("Cannot rewind a generator that was already run")) }
+            b"getreturn" if matches!(gs.status, GenStatus::Done) => Ok(gs.ret.clone()),
+            b"getreturn" => { drop(gs); Err(self.gen_exception("Cannot get return value of a generator that hasn't returned")) }
+            _ => Err(PhpError::Error(format!("Call to undefined method Generator::{}()", String::from_utf8_lossy(method)))),
+        }
+    }
+
+    fn finish_generator_drive(&mut self, drive: GeneratorDrive) -> Result<(), PhpError> {
+        match drive.after {
+            GeneratorAfter::Foreach { value, key, end } => {
+                let gs = drive.generator.borrow();
+                let f = &mut self.frames[drive.consumer];
+                if matches!(gs.status, GenStatus::Done) { f.ip = end as usize; }
+                else {
+                    store_slot(&mut f.slots[value as usize], gs.cur_val.deref_clone());
+                    if let Some(key) = key { store_slot(&mut f.slots[key as usize], gs.cur_key.clone()); }
+                }
+            }
+            GeneratorAfter::YieldFrom => {
+                let f = &mut self.frames[drive.consumer];
+                f.ext_mut().generator_ready = true;
+                f.ip -= 1;
+            }
+            GeneratorAfter::Method { method, next } => {
+                if let Some(value) = next {
+                    self.resume_generator_with(&drive.generator, value, Some(GeneratorAfter::Method {
+                        method: method.clone(), next: None,
+                    }))?;
+                }
+                let value = self.generator_result(&drive.generator, &method)?;
+                self.frames[drive.consumer].stack.push(value);
+            }
+        }
+        Ok(())
+    }
+
+fn discard_generator_drive(&mut self, drive: GeneratorDrive) {
+        if let GeneratorAfter::Method { next: Some(value), .. } = drive.after {
+            self.gc_note(&value);
+        }
+        let (key, value) = {
+            let mut gs = drive.generator.borrow_mut();
+            gs.status = GenStatus::Done;
+            (std::mem::replace(&mut gs.cur_key, Zval::Null),
+             std::mem::replace(&mut gs.cur_val, Zval::Null))
+        };
+        self.gc_note(&key);
+        self.gc_note(&value);
+    }
+
+    pub(super) fn discard_generator_captures(&mut self, baseline: usize) {
+        let captures = std::mem::take(&mut self.suspension_drives);
+        for drive in captures {
+            if drive.baseline >= baseline { self.discard_generator_drive(drive); }
+            else { self.suspension_drives.push(drive); }
+        }
+    }
+
+    pub(super) fn run_fiber_segment(&mut self, id: u32, baseline: usize) -> Result<RunExit, PhpError> {
+        // A nested Fiber owns its capture list independently of its caller.
+        let caller_captures = std::mem::take(&mut self.suspension_drives);
+        let mut drives = std::mem::take(&mut self.fibers.get_mut(&id).expect("fiber state").generator_drives);
+        let mut pending_error = None;
+        let result = loop {
+            let floor = drives.first().map_or(baseline, |d| d.baseline);
+            let outcome = match pending_error.take() {
+                Some(error) => Err(error),
+                None => self.run_loop(floor),
+            };
+            match outcome {
+                Ok(RunExit::Suspended { value }) | Err(PhpError::FiberSuspend(value)) => {
+                    let mut captured = std::mem::take(&mut self.suspension_drives);
+                    captured.append(&mut drives);
+                    for drive in &mut captured {
+                        drive.baseline -= baseline;
+                        drive.consumer -= baseline;
+                    }
+                    let frames = self.frames.split_off(baseline);
+                    let state = self.fibers.get_mut(&id).expect("fiber state");
+                    state.parked = frames;
+                    state.generator_drives = captured;
+                    break Ok(RunExit::Suspended { value });
+                }
+                Ok(exit) if !drives.is_empty() => {
+                    let drive = drives.remove(0);
+                    self.accept_generator_exit(&drive.generator, exit);
+                    if let Err(error) = self.finish_generator_drive(drive) { pending_error = Some(error); }
+                }
+                Ok(exit) => break Ok(exit),
+                Err(error) => {
+                    if let Some(error) = self.unwind(error, floor) {
+                        if drives.is_empty() { break Err(error); }
+                        let drive = drives.remove(0);
+                        while self.frames.len() > floor {
+                            let frame = self.frames.pop().expect("generator frame");
+                            self.gc_note_frame(&frame);
+                            self.recycle_frame(frame);
+                        }
+                        self.discard_generator_drive(drive);
+                        pending_error = Some(error);
+                    }
+                }
+            }
+        };
+        self.suspension_drives = caller_captures;
+        result
+    }
+}
